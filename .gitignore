# generated by every run (Docker or run_demo.py)
output/

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# experiment: raw traffic, traces and ground-truth logs are large and regenerated by bench/
results/*/*/capture/
results/*/*/telemetry/
results/*/*/gt/
results/*/trainticket-*/raw/
results/*/crapi-*/raw/

# packages
*.zip

# the open-source systems' own code (opensource/fetch.py downloads it)
opensource/*/upstream/

# demo-all output (demo/index.html is kept)
demo/*/
demo/*.log

# evaluation on the open-source systems: keep the Phase 1 output (live/scans/*/raw), the version 1.6
# analyses (v16/) and the summaries; the scan's own copies and the fixed deployment files are rebuilt
results/opensource/eval/*/*/runs/
results/opensource/eval/*/*/live/scans/*/analysis.json
results/opensource/eval/*/*/live/scans/*/eujf.json
results/opensource/fixes/*/
