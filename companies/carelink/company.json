{
 "_comment": "Generated by companies/build.py from company.yaml. Edit company.yaml, not this file.",
 "id": "carelink",
 "name": "CareLink",
 "credential": "bearer",
 "auth_service": {
  "name": "auth-service",
  "port": 8000
 },
 "gateway": {
  "name": "web-gateway",
  "type": "nginx",
  "port": 8080,
  "traced": false,
  "routes": [
   {
    "prefix": "/api/appointments",
    "service": "appointment-service",
    "port": 8000,
    "from": "/api/appointments",
    "to": "/appointments",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/patients",
    "service": "patient-service",
    "port": 8000,
    "from": "/api/patients",
    "to": "/patients",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/records",
    "service": "records-service",
    "port": 8000,
    "from": "/api/records",
    "to": "/records",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/auth",
    "service": "auth-service",
    "port": 8000,
    "from": "/api/auth",
    "to": "/auth",
    "auth": false,
    "limit_per_min": 60
   }
  ]
 },
 "services": {
  "auth-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/auth-service.json",
    "type": "application/json"
   },
   "routes": []
  },
  "patient-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/patient-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/patients/{patient_id}",
     "auth": "user",
     "owner": "patient_id",
     "returns": {
      "patient_id": "$patient_id",
      "customer_id": "$owner",
      "phone": "***",
      "email": "***",
      "dob": "***",
      "blood_type": "***"
     },
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "PUT",
     "path": "/patients/{patient_id}/contact-preferences",
     "auth": "user",
     "owner": "patient_id",
     "returns": {
      "patient_id": "$patient_id",
      "status": "updated"
     },
     "traffic": {
      "body": {
       "channel": "sms",
       "language": "th"
      }
     }
    },
    {
     "method": "GET",
     "path": "/patients/search",
     "auth": "admin",
     "returns": {
      "items": [
       {
        "patient_id": "$n",
        "customer_id": "c1",
        "phone": "***"
       }
      ]
     },
     "traffic": {
      "query": {
       "ward": "4B"
      }
     }
    }
   ]
  },
  "appointment-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/appointment-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/appointments",
     "auth": "user",
     "returns": {
      "items": [
       {
        "appointment_id": "$n",
        "customer_id": "$user",
        "slot": "09:30"
       }
      ]
     }
    },
    {
     "method": "POST",
     "path": "/appointments",
     "auth": "user",
     "status": 201,
     "returns": {
      "appointment_id": "$n",
      "status": "booked"
     },
     "traffic": {
      "body": {
       "patient_id": "$owned",
       "slot_id": 12,
       "reason": "checkup"
      }
     }
    },
    {
     "method": "GET",
     "path": "/appointments/{appointment_id}",
     "auth": "user",
     "owner": "appointment_id",
     "returns": {
      "appointment_id": "$appointment_id",
      "customer_id": "$owner",
      "doctor": "Internal medicine",
      "slot": "09:30",
      "notes": "***"
     },
     "owner_check": false
    },
    {
     "method": "DELETE",
     "path": "/appointments/{appointment_id}",
     "auth": "user",
     "owner": "appointment_id",
     "returns": {
      "appointment_id": "$appointment_id",
      "status": "cancelled"
     },
     "traffic": {
      "weight": 1
     }
    }
   ]
  },
  "records-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/records-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/records/{record_id}",
     "auth": "user",
     "owner": "record_id",
     "returns": {
      "record_id": "$record_id",
      "customer_id": "$owner",
      "diagnosis_code": "***",
      "issued": "2026-10-01"
     },
     "calls": [
      {
       "service": "patient-service",
       "port": 8000,
       "method": "GET",
       "path": "/patients/{record_id}",
       "forward_auth": true,
       "body": null
      }
     ]
    },
    {
     "method": "GET",
     "path": "/records/{record_id}/pdf",
     "auth": "user",
     "owner": "record_id",
     "returns": {
      "record_id": "$record_id",
      "format": "pdf",
      "pages": 2
     },
     "traffic": {
      "query": {
       "access_token": "$token"
      },
      "credential_in_query": true
     }
    }
   ]
  },
  "reporting-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/reporting-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/internal/census",
     "auth": "none",
     "returns": {
      "wards": 12,
      "admitted_today": 0,
      "discharged_today": 0
     },
     "traffic": {
      "client": "none"
     }
    }
   ]
  }
 },
 "cron": [
  {
   "name": "census-export",
   "every": 2,
   "calls": [
    {
     "service": "reporting-service",
     "port": 8000,
     "method": "GET",
     "path": "/internal/census",
     "body": null
    }
   ]
  }
 ]
}
