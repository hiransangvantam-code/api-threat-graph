{
  "swagger": "2.0",
  "info": {
    "title": "FoodDash Auth Service API",
    "version": "1.3.0"
  },
  "host": "auth-service:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/auth/session": {
      "post": {
        "operationId": "post_auth_session",
        "summary": "POST /auth/session",
        "tags": [
          "auth-service"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "access_token": {
                  "type": "string"
                },
                "token_type": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/introspect": {
      "get": {
        "operationId": "get_auth_introspect",
        "summary": "GET /auth/introspect",
        "tags": [
          "auth-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "active": {
                  "type": "boolean"
                }
              }
            }
          },
          "401": {
            "description": "No valid credential"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  }
}
