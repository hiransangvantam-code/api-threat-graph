{
  "swagger": "2.0",
  "info": {
    "title": "FoodDash Rider Service API",
    "version": "1.2.0"
  },
  "host": "rider-service:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/riders/nearby": {
      "get": {
        "operationId": "get_riders_nearby",
        "summary": "GET /riders/nearby",
        "tags": [
          "rider-service"
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rider_id": {
                        "type": "integer"
                      },
                      "eta_min": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid credential"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  }
}
