  "name": "auth-service",
  "port": 8000
 },
 "gateway": {
  "name": "api-gateway",
  "type": "spring-cloud-gateway",
  "port": 8080,
  "traced": true,
  "routes": [
   {
    "prefix": "/api/policies",
    "service": "policy-service",
    "port": 8000,
    "from": "/api/policies",
    "to": "/policies",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/reports",
    "service": "reporting-service",
    "port": 8000,
    "from": "/api/reports",
    "to": "/reports",
    "auth": false,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/claims",
    "service": "claim-service",
    "port": 8000,
    "from": "/api/claims",
    "to": "/claims",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/auth",
    "service": "auth-service",
    "port": 8000,
    "from": "/api/auth",
    "to": "/auth",
    "auth": false,
    "limit_per_min": 60
   }
  ]
 },
 "services": {
  "auth-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/auth-service.json",
    "type": "application/json"
   },
   "routes": []
  },
  "policy-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/policy-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/policies",
     "auth": "user",
     "returns": {
      "items": [
       {
        "policy_id": "$n",
        "product": "motor",
        "premium_amount": 0
       }
      ]
     }
    },
    {
     "method": "GET",
     "path": "/policies/{policy_id}",
     "auth": "user",
     "owner": "policy_id",
     "returns": {
      "policy_id": "$policy_id",
      "customer_id": "$owner",
      "product": "motor",
      "premium_amount": 0,
      "insured_address": "***"
     },
     "calls": [
      {
       "service": "underwriting-service",
       "port": 8000,
       "method": "GET",
       "path": "/underwriting/score/{policy_id}",
       "forward_auth": true,
       "body": null
      }
     ],
     "traffic": {
      "weight": 3
     }
    }
   ]
  },
  "claim-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/claim-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/claims",
     "auth": "user",
     "status": 201,
     "returns": {
      "claim_id": "$n",
      "status": "received"
     },
     "traffic": {
      "body": {
       "policy_id": "$owned",
       "description": "rear bumper",
       "photo_url": "https://photos.insureco.example/upload/claim.jpg"
      }
     }
    },
    {
     "method": "GET",
     "path": "/claims/{claim_id}",
     "auth": "user",
     "owner": "claim_id",
     "returns": {
      "claim_id": "$claim_id",
      "customer_id": "$owner",
      "status": "assessing",
      "amount": 0
     }
    },
    {
     "method": "GET",
     "path": "/claims/{claim_id}/documents",
     "auth": "user",
     "owner": "claim_id",
     "returns": {
      "claim_id": "$claim_id",
      "items": [
       {
        "document_id": "$n",
        "kind": "photo"
       }
      ]
     }
    }
   ]
  },
  "underwriting-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/underwriting-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/underwriting/score/{policy_id}",
     "auth": "user",
     "owner": "policy_id",
     "returns": {
      "policy_id": "$policy_id",
      "risk_band": "B"
     },
     "traffic": {
      "client": "none"
     }
    }
   ]
  },
  "reporting-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/reporting-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/reports/claims-export",
     "auth": "none",
     "returns": {
      "items": [
       {
        "claim_id": "$n",
        "customer_id": "c1",
        "amount": 0,
        "email": "***"
       }
      ]
     },
     "traffic": {
      "weight": 1,
      "ua": "bi-connector/2.3",
      "client": "anonymous"
     }
    },
    {
     "method": "GET",
     "path": "/reports/weekly-summary",
     "auth": "admin",
     "returns": {
      "claims": 0,
      "paid_amount": 0
     }
    }
   ]
  }
 },
 "cron": []
}
