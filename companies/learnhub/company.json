   },
   {
    "prefix": "/api/courses",
    "service": "course-service",
    "port": 3000,
    "from": "/api/courses",
    "to": "/courses",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/quizzes",
    "service": "legacy-quiz-service",
    "port": 3000,
    "from": "/api/quizzes",
    "to": "/quizzes",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/grades",
    "service": "grade-service",
    "port": 3000,
    "from": "/api/grades",
    "to": "/grades",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/admin",
    "service": "admin-service",
    "port": 3000,
    "from": "/api/admin",
    "to": "/admin",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/auth",
    "service": "auth-service",
    "port": 3000,
    "from": "/api/auth",
    "to": "/auth",
    "auth": false,
    "limit_per_min": 60
   }
  ]
 },
 "services": {
  "auth-service": {
   "port": 3000,
   "traced": true,
   "spec": {
    "path": "/api-docs",
    "file": "live-specs/auth-service.json",
    "type": "application/json"
   },
   "routes": []
  },
  "course-service": {
   "port": 3000,
   "traced": true,
   "spec": {
    "path": "/api-docs",
    "file": "live-specs/course-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/courses",
     "auth": "user",
     "returns": {
      "items": [
       {
        "course_id": "$n",
        "title": "Course",
        "level": "beginner"
       }
      ]
     },
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "GET",
     "path": "/courses/{course_id}",
     "auth": "user",
     "returns": {
      "course_id": "$course_id",
      "title": "Course",
      "instructor": "staff1",
      "lessons": 12
     }
    },
    {
     "method": "GET",
     "path": "/courses/{course_id}/materials",
     "auth": "user",
     "returns": {
      "course_id": "$course_id",
      "items": [
       {
        "material_id": "$n",
        "kind": "video"
       }
      ]
     }
    }
   ]
  },
  "enrollment-service": {
   "port": 3000,
   "traced": true,
   "spec": {
    "path": "/api-docs",
    "file": "live-specs/enrollment-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/enrollments",
     "auth": "user",
     "status": 201,
     "returns": {
      "enrollment_id": "$n",
      "status": "active"
     },
     "calls": [
      {
       "service": "course-service",
       "port": 3000,
       "method": "GET",
       "path": "/courses/101",
       "forward_auth": true,
       "body": null
      }
     ],
     "traffic": {
      "body": {
       "course_id": 101
      }
     }
    },
    {
     "method": "GET",
     "path": "/enrollments/{enrollment_id}",
     "auth": "user",
     "owner": "enrollment_id",
     "returns": {
      "enrollment_id": "$enrollment_id",
      "user_id": "$owner",
      "course_id": 101,
      "progress": 40
     }
    }
   ]
  },
  "grade-service": {
   "port": 3000,
   "traced": true,
   "spec": {
    "path": "/api-docs",
    "file": "live-specs/grade-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/grades/{student_id}",
     "auth": "user",
     "owner": "student_id",
     "returns": {
      "user_id": "$owner",
      "items": [
       {
        "course_id": 101,
        "grade": "B+"
       }
      ]
     },
     "owner_check": false,
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "PUT",
     "path": "/grades/{student_id}/courses/{course_id}",
     "auth": "admin",
     "returns": {
      "student_id": "$student_id",
      "course_id": "$course_id",
      "status": "updated"
     },
     "traffic": {
      "body": {
       "grade": "A"
      }
     }
    }
   ]
  },
  "admin-service": {
   "port": 3000,
   "traced": true,
   "spec": {
    "path": "/api-docs",
    "file": "live-specs/admin-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/admin/stats",
     "auth": "admin",
     "returns": {
      "active_users": 0,
      "courses": 0
     }
    },
    {
     "method": "GET",
     "path": "/admin/users/export",
     "auth": "user",
     "returns": {
      "items": [
       {
        "user_id": "$n",
        "email": "***",
        "phone": "***"
       }
      ]
     },
     "traffic": {
      "weight": 1
     }
    }
   ]
  },
  "legacy-quiz-service": {
   "port": 3000,
   "traced": true,
   "spec": null,
   "routes": [
    {
     "method": "GET",
     "path": "/quizzes/{quiz_id}",
     "auth": "user",
     "returns": {
      "quiz_id": "$quiz_id",
      "questions": 10
     }
    },
    {
     "method": "POST",
     "path": "/quizzes/{quiz_id}/attempts",
     "auth": "user",
     "status": 201,
     "returns": {
      "attempt_id": "$n",
      "score": 7
     },
     "traffic": {
      "body": {
       "answers": [
        1,
        3,
        2
       ]
      }
     }
    }
   ]
  }
 },
 "cron": []
}
