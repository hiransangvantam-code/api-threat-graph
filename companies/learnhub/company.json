{
 "_comment": "Generated by companies/build.py from company.yaml. Edit company.yaml, not this file.",
 "id": "learnhub",
 "name": "LearnHub",
 "credential": "bearer",
 "auth_service": {
  "name": "auth-service",
  "port": 3000
 },
 "gateway": {
  "name": "edge-gateway",
  "type": "configmap",
  "port": 8000,
  "traced": true,
  "routes": [
   {
    "prefix": "/api/enrollments",
    "service": "enrollment-service",
    "port": 3000,
    "from": "/api/enrollments",
    "to": "/enrollments",
