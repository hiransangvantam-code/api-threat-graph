{
  "openapi": "3.0.3",
  "info": {
    "title": "LearnHub Enrollment Service API",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "http://enrollment-service:3000"
    }
  ],
  "paths": {
    "/enrollments": {
      "post": {
        "operationId": "post_enrollments",
        "summary": "POST /enrollments",
        "tags": [
          "enrollment-service"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "course_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enrollment_id": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid credential"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/enrollments/{enrollment_id}": {
      "get": {
        "operationId": "get_enrollments_enrollment_id",
        "summary": "GET /enrollments/{enrollment_id}",
        "tags": [
          "enrollment-service"
        ],
        "parameters": [
          {
            "name": "enrollment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enrollment_id": {
                      "type": "integer"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "course_id": {
                      "type": "integer"
                    },
                    "progress": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid credential"
          },
          "403": {
            "description": "Not allowed for this user"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
