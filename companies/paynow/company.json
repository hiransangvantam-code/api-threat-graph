  "port": 8080
 },
 "gateway": {
  "name": "kong",
  "type": "kong",
  "port": 8000,
  "traced": true,
  "routes": [
   {
    "prefix": "/api/transfers",
    "service": "transfer-service",
    "port": 8080,
    "from": "/api/transfers",
    "to": "/transfers",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/merchants",
    "service": "merchant-service",
    "port": 8080,
    "from": "/api/merchants",
    "to": "/merchants",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/wallets",
    "service": "wallet-service",
    "port": 8080,
    "from": "/api/wallets",
    "to": "/wallets",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/auth",
    "service": "auth-service",
    "port": 8080,
    "from": "/api/auth",
    "to": "/auth",
    "auth": false,
    "limit_per_min": 60
   }
  ]
 },
 "services": {
  "auth-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.yaml",
    "file": "live-specs/auth-service.yaml",
    "type": "application/yaml"
   },
   "routes": []
  },
  "wallet-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.yaml",
    "file": "live-specs/wallet-service.yaml",
    "type": "application/yaml"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/wallets/{wallet_id}",
     "auth": "user",
     "owner": "wallet_id",
     "returns": {
      "wallet_id": "$wallet_id",
      "owner_id": "$owner",
      "balance": 0,
      "currency": "THB"
     },
     "calls": [
      {
       "service": "ledger-service",
       "port": 8080,
       "method": "GET",
       "path": "/ledger/accounts/{wallet_id}/balance",
       "forward_auth": true,
       "body": null
      }
     ],
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "GET",
     "path": "/wallets/{wallet_id}/statement",
     "auth": "user",
     "owner": "wallet_id",
     "returns": {
      "wallet_id": "$wallet_id",
      "owner_id": "$owner",
      "items": [
       {
        "transaction_id": "$n",
        "amount": 0,
        "merchant": "Cafe"
       }
      ]
     },
     "owner_check": false
    },
    {
     "method": "POST",
     "path": "/wallets/{wallet_id}/topup",
     "auth": "user",
     "owner": "wallet_id",
     "returns": {
      "wallet_id": "$wallet_id",
      "status": "accepted"
     },
     "calls": [
      {
       "service": "ledger-service",
       "port": 8080,
       "method": "POST",
       "path": "/ledger/entries",
       "forward_auth": false,
       "body": {
        "entry": "topup",
        "amount": 500
       }
      }
     ],
     "traffic": {
      "body": {
       "amount": 500,
       "source": "bank"
      }
     }
    }
   ]
  },
  "transfer-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.yaml",
    "file": "live-specs/transfer-service.yaml",
    "type": "application/yaml"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/transfers",
     "auth": "user",
     "errors_every": 25,
     "status": 201,
     "returns": {
      "transfer_id": "$n",
      "status": "pending"
     },
     "calls": [
      {
       "service": "ledger-service",
       "port": 8080,
       "method": "POST",
       "path": "/ledger/entries",
       "forward_auth": false,
       "body": {
        "entry": "transfer",
        "amount": 50
       }
      }
     ],
     "external": [
      {
       "method": "GET",
       "host": "fx-rates",
       "path": "/rates",
       "port": 9000
      }
     ],
     "traffic": {
      "body": {
       "from_wallet": "$owned",
       "to_wallet": 1007,
       "amount": 50
      }
     }
    },
    {
     "method": "GET",
     "path": "/transfers/{transfer_id}",
     "auth": "user",
     "owner": "transfer_id",
     "returns": {
      "transfer_id": "$transfer_id",
      "owner_id": "$owner",
      "amount": 0,
      "status": "completed"
     }
    }
   ]
  },
  "ledger-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.yaml",
    "file": "live-specs/ledger-service.yaml",
    "type": "application/yaml"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/ledger/entries",
     "auth": "none",
     "status": 201,
     "returns": {
      "entry_id": "$n",
      "status": "posted"
     },
     "traffic": {
      "client": "none",
      "body": {
       "entry": "topup",
       "amount": 500
      }
     }
    },
    {
     "method": "GET",
     "path": "/ledger/accounts/{account_id}/balance",
     "auth": "user",
     "owner": "account_id",
     "returns": {
      "account_id": "$account_id",
      "balance": 0
     },
     "traffic": {
      "client": "none"
     }
    }
   ]
  },
  "merchant-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.yaml",
    "file": "live-specs/merchant-service.yaml",
    "type": "application/yaml"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/merchants/{merchant_id}",
     "auth": "user",
     "returns": {
      "merchant_id": "$merchant_id",
      "name": "Cafe",
      "category": "food"
     }
    },
    {
     "method": "GET",
     "path": "/merchants/{merchant_id}/settlements",
     "auth": "admin",
     "returns": {
      "merchant_id": "$merchant_id",
      "items": [
       {
        "settlement_id": "$n",
        "amount": 0
       }
      ]
     }
    }
   ]
  },
  "fx-rates": {
   "port": 9000,
   "traced": false,
   "external": true,
   "spec": null,
   "routes": [
    {
     "method": "GET",
     "path": "/rates",
     "auth": "none",
     "returns": {
      "base": "THB",
      "quote": "USD",
      "rate": 0.03
     }
    }
   ]
  }
 },
 "cron": []
}
