 "services": {
  "auth-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/auth-service.json",
    "type": "application/json"
   },
   "routes": []
  },
  "catalog-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/catalog-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/titles",
     "auth": "user",
     "returns": {
      "items": [
       {
        "title_id": "$n",
        "name": "Title",
        "genre": "drama"
       }
      ]
     },
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "GET",
     "path": "/titles/{title_id}",
     "auth": "user",
     "returns": {
      "title_id": "$title_id",
      "name": "Title",
      "seasons": 2
     }
    },
    {
     "method": "POST",
     "path": "/titles/{title_id}/playback",
     "auth": "user",
     "returns": {
      "title_id": "$title_id",
      "manifest": "/hls/main.m3u8"
     },
     "calls": [
      {
       "service": "drm-service",
       "port": 8000,
       "method": "POST",
       "path": "/licenses",
       "forward_auth": true,
       "body": null
      },
      {
       "service": "recommendation-service",
       "port": 8000,
       "method": "GET",
       "path": "/recommendations/{title_id}",
       "forward_auth": true,
       "body": null
      }
     ],
     "traffic": {
      "weight": 3,
      "body": {
       "device": "tv"
      }
     }
    }
   ]
  },
  "profile-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/profile-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/profiles/{profile_id}",
     "auth": "user",
     "owner": "profile_id",
     "returns": {
      "profile_id": "$profile_id",
      "user_id": "$owner",
      "email": "***",
      "birth_year": "***",
      "plan": "premium"
     }
    },
    {
     "method": "PUT",
     "path": "/profiles/{profile_id}/preferences",
     "auth": "user",
     "owner": "profile_id",
     "returns": {
      "profile_id": "$profile_id",
      "status": "saved"
     },
     "traffic": {
      "body": {
       "subtitles": "th",
       "autoplay": false
      }
     }
    }
   ]
  },
  "billing-service": {
   "port": 8000,
   "traced": true,
   "spec": null,
   "routes": [
    {
     "method": "GET",
     "path": "/billing/invoices",
     "auth": "user",
     "returns": {
      "items": [
       {
        "invoice_id": "$n",
        "amount": 0,
        "currency": "THB"
       }
      ]
     }
    },
    {
     "method": "GET",
     "path": "/billing/invoices/{invoice_id}",
     "auth": "user",
     "owner": "invoice_id",
     "returns": {
      "invoice_id": "$invoice_id",
      "user_id": "$owner",
      "amount": 0
     }
    },
    {
     "method": "POST",
     "path": "/billing/payment-methods",
     "auth": "user",
     "status": 201,
     "returns": {
      "payment_method_id": "$n",
      "status": "verified"
     },
     "traffic": {
