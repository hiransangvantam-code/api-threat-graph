   },
   "routes": [
    {
     "method": "GET",
     "path": "/recommendations/{title_id}",
     "auth": "user",
     "errors_every": 15,
     "returns": {
      "items": [
       {
        "title_id": "$n",
        "score": 0.8
       }
      ]
     },
     "traffic": {
      "client": "none"
     }
    }
   ]
  },
  "drm-service": {
   "port": 8000,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/drm-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
