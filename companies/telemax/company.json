{
 "_comment": "Generated by companies/build.py from company.yaml. Edit company.yaml, not this file.",
 "id": "telemax",
 "name": "TeleMax",
 "credential": "bearer",
 "auth_service": {
  "name": "auth-service",
  "port": 8080
 },
 "gateway": {
  "name": "api-gateway",
  "type": "spring-cloud-gateway",
  "port": 8080,
  "traced": true,
  "routes": [
   {
    "prefix": "/api/subscribers",
    "service": "subscriber-service",
    "port": 8080,
    "from": "/api/subscribers",
    "to": "/subscribers",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/porting",
    "service": "number-porting-service",
    "port": 8080,
    "from": "/api/porting",
    "to": "/porting",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/devices",
    "service": "device-service",
    "port": 8080,
    "from": "/api/devices",
    "to": "/devices",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/tickets",
    "service": "support-service",
    "port": 8080,
    "from": "/api/tickets",
    "to": "/tickets",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/plans",
    "service": "plan-service",
    "port": 8080,
    "from": "/api/plans",
    "to": "/plans",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/usage",
    "service": "usage-service",
    "port": 8080,
    "from": "/api/usage",
    "to": "/usage",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/bills",
    "service": "billing-service",
    "port": 8080,
    "from": "/api/bills",
    "to": "/bills",
    "auth": true,
    "limit_per_min": 0
   },
   {
    "prefix": "/api/auth",
    "service": "auth-service",
    "port": 8080,
    "from": "/api/auth",
    "to": "/auth",
    "auth": false,
    "limit_per_min": 60
   },
   {
    "prefix": "/api/sims",
    "service": "sim-service",
    "port": 8080,
    "from": "/api/sims",
    "to": "/sims",
    "auth": true,
    "limit_per_min": 0
   }
  ]
 },
 "services": {
  "auth-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/auth-service.json",
    "type": "application/json"
   },
   "routes": []
  },
  "subscriber-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/subscriber-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/subscribers/{subscriber_id}",
     "auth": "user",
     "owner": "subscriber_id",
     "returns": {
      "subscriber_id": "$subscriber_id",
      "user_id": "$owner",
      "email": "***",
      "address": "***",
      "plan_id": 3
     },
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "PATCH",
     "path": "/subscribers/{subscriber_id}",
     "auth": "user",
     "owner": "subscriber_id",
     "returns": {
      "subscriber_id": "$subscriber_id",
      "status": "updated"
     },
     "traffic": {
      "body": {
       "plan_id": 4
      }
     }
    }
   ]
  },
  "plan-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/plan-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/plans",
     "auth": "user",
     "returns": {
      "items": [
       {
        "plan_id": "$n",
        "name": "5G Max",
        "monthly_fee": 599
       }
      ]
     },
     "traffic": {
      "weight": 3
     }
    },
    {
     "method": "GET",
     "path": "/plans/{plan_id}",
     "auth": "user",
     "returns": {
      "plan_id": "$plan_id",
      "name": "5G Max",
      "data_gb": 100
     }
    }
   ]
  },
  "usage-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/usage-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/usage/{subscriber_id}",
     "auth": "user",
     "owner": "subscriber_id",
     "returns": {
      "user_id": "$owner",
      "data_mb": 0,
      "minutes": 0
     },
     "traffic": {
      "weight": 3,
      "query": {
       "month": "2026-10"
      }
     }
    },
    {
     "method": "GET",
     "path": "/usage/{subscriber_id}/cdr",
     "auth": "user",
     "owner": "subscriber_id",
     "returns": {
      "user_id": "$owner",
      "items": [
       {
        "call_id": "$n",
        "duration_s": 60,
        "called_number": "***"
       }
      ]
     },
     "owner_check": false
    }
   ]
  },
  "billing-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/billing-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/bills/{bill_id}",
     "auth": "user",
     "owner": "bill_id",
     "returns": {
      "bill_id": "$bill_id",
      "user_id": "$owner",
      "amount": 0,
      "due": "2026-11-30"
     }
    },
    {
     "method": "POST",
     "path": "/bills/{bill_id}/pay",
     "auth": "user",
     "owner": "bill_id",
     "status": 201,
     "returns": {
      "bill_id": "$bill_id",
      "payment_id": "$n",
      "status": "paid"
     },
     "external": [
      {
       "method": "POST",
       "host": "bank-switch",
       "path": "/payments",
       "port": 9000
      }
     ],
     "traffic": {
      "body": {
       "amount": 599
      }
     }
    }
   ]
  },
  "sim-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/sim-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/sims/{sim_id}/swap",
     "auth": "user",
     "owner": "sim_id",
     "errors_every": 20,
     "returns": {
      "sim_id": "$sim_id",
      "status": "swap_pending"
     },
     "calls": [
      {
       "service": "subscriber-service",
       "port": 8080,
       "method": "GET",
       "path": "/subscribers/{sim_id}",
       "forward_auth": true,
       "body": null
      }
     ],
     "traffic": {
      "body": {
       "reason": "lost"
      }
     }
    }
   ]
  },
  "network-ops-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/network-ops-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/ops/cell-status",
     "auth": "none",
     "returns": {
      "cells_up": 0,
      "cells_down": 0
     },
     "traffic": {
      "client": "none"
     }
    }
   ]
  },
  "number-porting-service": {
   "port": 8080,
   "traced": false,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/number-porting-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/porting",
     "auth": "user",
     "status": 201,
     "returns": {
      "request_id": "$n",
      "status": "submitted"
     },
     "traffic": {
      "body": {
       "donor_operator": "OtherTel"
      }
     }
    },
    {
     "method": "GET",
     "path": "/porting/{request_id}",
     "auth": "user",
     "owner": "request_id",
     "returns": {
      "request_id": "$request_id",
      "user_id": "$owner",
      "status": "pending"
     }
    }
   ]
  },
  "device-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/device-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/devices/{device_id}",
     "auth": "user",
     "owner": "device_id",
     "returns": {
      "device_id": "$device_id",
      "user_id": "$owner",
      "model": "Phone X",
      "imei": "***"
     }
    }
   ]
  },
  "support-service": {
   "port": 8080,
   "traced": true,
   "spec": {
    "path": "/openapi.json",
    "file": "live-specs/support-service.json",
    "type": "application/json"
   },
   "routes": [
    {
     "method": "POST",
     "path": "/tickets",
     "auth": "user",
     "status": 201,
     "returns": {
      "ticket_id": "$n",
      "status": "open"
     },
     "traffic": {
      "body": {
       "topic": "billing",
       "message": "bill looks wrong"
      }
     }
    },
    {
     "method": "GET",
     "path": "/tickets/{ticket_id}",
     "auth": "user",
     "owner": "ticket_id",
     "returns": {
      "ticket_id": "$ticket_id",
      "user_id": "$owner",
      "status": "open"
     }
    },
    {
     "method": "GET",
     "path": "/tickets/search",
     "auth": "admin",
     "returns": {
      "items": [
       {
        "ticket_id": "$n",
        "user_id": "c1"
       }
      ]
     },
     "traffic": {
      "query": {
       "q": "billing"
      }
     }
    }
   ]
  },
  "bank-switch": {
   "port": 9000,
   "traced": false,
   "external": true,
   "spec": null,
   "routes": [
    {
     "method": "POST",
     "path": "/payments",
     "auth": "none",
     "returns": {
      "status": "approved"
     }
    }
   ]
  }
 },
 "cron": [
  {
   "name": "noc-dashboard",
   "every": 2,
   "calls": [
    {
     "service": "network-ops-service",
     "port": 8080,
     "method": "GET",
     "path": "/ops/cell-status",
     "body": null
    }
   ]
  }
 ]
}
