# Online Boutique on its published images (us-central1-docker.pkg.dev/online-boutique-ci/...:v0.10.7):
# docker-compose.yml here is made from the system's release manifests by k8s2compose.py, with tracing
# switched on and pointed at the ATG Collector. Its own load generator (Locust) runs for two minutes.
COMPOSE_FILES=opensource/real/online-boutique/docker-compose.yml
OWN_LOAD=loadgenerator
SECRETS=
WARMUP=90
