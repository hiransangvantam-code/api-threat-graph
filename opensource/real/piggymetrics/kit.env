# PiggyMetrics on its published images (sqshq/piggymetrics-*, Docker Hub). Its passwords are made up
# fresh for every run by real.sh / REAL-Windows.bat and kept only in that run's environment.
COMPOSE_FILES=opensource/piggymetrics/upstream/docker-compose.yml opensource/real/piggymetrics/override.yml
OWN_LOAD=
SECRETS=CONFIG_SERVICE_PASSWORD NOTIFICATION_SERVICE_PASSWORD STATISTICS_SERVICE_PASSWORD ACCOUNT_SERVICE_PASSWORD MONGODB_PASSWORD
WARMUP=240
